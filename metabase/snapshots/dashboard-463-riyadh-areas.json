        "dataset_query": {
          "lib/type": "mbql/query",
          "database": 67,
          "stages": [
            {
              "template-tags": [
                {
                  "display-name": "الشهر",
                  "id": "month-tag",
                  "name": "month",
                  "type": "text"
                }
              ],
              "lib/type": "mbql.stage/native",
              "native": "SELECT a.name AS الحي, COUNT(*) AS عدد_الطلبات, SUM(reservations.use_package=0) AS مفردة, SUM(reservations.use_package=1) AS باقات, ROUND(AVG(CAST(reservations.total_price AS DECIMAL(12,2))),0) AS متوسط_القيمة, ROUND(100*COUNT(*)/SUM(COUNT(*)) OVER (),1) AS نسبة_من_الرياض FROM reservations JOIN areas a ON a.id=reservations.area_id WHERE reservations.deleted_at IS NULL AND reservations.city_id=2 [[ AND DATE_FORMAT(reservations.created_at,'%Y-%m') = {{month}} ]] GROUP BY a.name ORDER BY عدد_الطلبات DESC"
            }
          ]
        },
