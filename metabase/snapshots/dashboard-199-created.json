          "stages": [
            {
              "lib/type": "mbql.stage/native",
              "native": "SELECT DATE(created_at) AS day, ROUND(SUM(CAST(total_price AS DECIMAL(12,2))),2) AS sales FROM reservations WHERE deleted_at IS NULL AND created_at >= DATE_SUB(CURDATE(), INTERVAL 30 DAY) GROUP BY DATE(created_at) ORDER BY day"
