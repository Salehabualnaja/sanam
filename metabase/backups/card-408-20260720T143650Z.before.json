    "lib/type": "mbql/query",
    "database": 67,
    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "SELECT CAST(DATE_FORMAT(created_at,'%Y-%m-01') AS DATE) AS month, ROUND(AVG(TIMESTAMPDIFF(HOUR,created_at,answer_at)),1) AS avg_hours FROM client_complaints WHERE deleted_at IS NULL AND answer_at IS NOT NULL GROUP BY 1 ORDER BY 1"
      }
    ]
  },
