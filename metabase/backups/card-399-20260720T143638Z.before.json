    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "SELECT CAST(DATE_FORMAT(created_at,'%Y-%m-01') AS DATE) AS month, SUM(use_package=1) AS package_orders, ROUND(100*SUM(use_package=1)/COUNT(*),1) AS package_pct FROM reservations WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 1"
      }
    ]
