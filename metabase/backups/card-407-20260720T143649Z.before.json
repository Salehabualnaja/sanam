  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 67,
    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "SELECT CAST(DATE_FORMAT(created_at,'%Y-%m-01') AS DATE) AS month, ROUND(AVG(score),2) AS avg_score, ROUND(100*SUM(score>=4)/COUNT(*),1) AS csat_pct FROM reviews WHERE deleted_at IS NULL GROUP BY 1 ORDER BY 1"
      }
    ]
  },
