  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 67,
    "stages": [
      {
        "lib/type": "mbql.stage/native",
        "native": "SELECT month, ROUND(completed/NULLIF(reps*days,0),2) AS per_washer_per_day FROM (SELECT CAST(DATE_FORMAT(created_at,'%Y-%m-01') AS DATE) AS month, COUNT(*) AS completed, COUNT(DISTINCT representative_id) AS reps, COUNT(DISTINCT DATE(created_at)) AS days FROM reservations WHERE deleted_at IS NULL AND status=3 AND representative_id IS NOT NULL GROUP BY 1) t ORDER BY 1"
      }
    ]
  },
