  "dataset_query": {
    "lib/type": "mbql/query",
    "database": 67,
    "stages": [
      {
        "template-tags": {
          "granularity": {
            "type": "text",
            "id": "gran-tag",
            "name": "granularity",
            "display-name": "Granularity",
            "default": "daily"
          }
        },
        "lib/type": "mbql.stage/native",
        "native": "WITH g AS (SELECT CASE WHEN {{granularity}}='monthly' THEN CAST(DATE_FORMAT(created_at,'%Y-%m-01') AS DATE) ELSE DATE(created_at) END AS period, SUM(CAST(total_price AS DECIMAL(12,2))) n\n           FROM reservations WHERE deleted_at IS NULL GROUP BY 1)\nSELECT period, ROUND(CASE WHEN {{granularity}}='cumulative' THEN SUM(n) OVER (ORDER BY period) ELSE n END,2) AS sales\nFROM g ORDER BY period\n"
      }
    ]
  },
